{
  "name": "sharp-records-site",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-cms.mjs",
    "prebuild": "node scripts/copy-cms.mjs",
    "dev": "astro dev --host 127.0.0.1 --port 4321",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4173",
    "cms": "MODE=git decap-server",
    "test": "astro build && playwright test && node --test tests/validate.test.js",
    "serve": "python3 -m http.server 4173 --bind 127.0.0.1 --directory dist"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "html-validate": "^9.7.1"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.6",
    "astro": "^5.18.2",
    "decap-cms": "^3.18.0",
    "decap-server": "^3.11.6",
    "sharp": "^0.35.5"
  }
}
