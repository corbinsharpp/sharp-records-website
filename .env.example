# Environment variables

Copy this file to `.env` only for local experiments. Do not commit `.env`.
On Cloudflare Pages, add the same names under Settings → Variables and Secrets, then redeploy.
Leave a value blank to keep that feature switched off.

# Public site address used for links, the sitemap and social tags.
PUBLIC_SITE_URL=https://sharprecords.uk

# Google Analytics 4 measurement ID. Loaded only after a visitor presses Accept.
# Example shape: G-XXXXXXXXXX
PUBLIC_GA_MEASUREMENT_ID=

# Cloudflare Turnstile. Both keys are required before the enquiry form or newsletter will send.
# Site key is public. Secret key must be a secret.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# GitHub OAuth app for the dashboard at /admin.
# Add these on Cloudflare Pages → Settings → Environment variables → Production.
# GITHUB_CLIENT_SECRET must be a Secret. Leave SITE_AUTH_ORIGIN blank.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional. Blank means "use the address the browser is on"
# (pages.dev now, sharprecords.uk later). No trailing slash.
# SITE_AUTH_ORIGIN=

# Optional. Blank means the branch Cloudflare is publishing today:
# cursor/cms-dashboard-784c. Set to main when production builds from main.
# CMS_BRANCH=

# Buttondown API key. Subscribers are stored there, not in this repository.
BUTTONDOWN_API_KEY=

# Formspree form ID only, not the whole URL. Example shape: abcdwxyz
FORMSPREE_FORM_ID=
