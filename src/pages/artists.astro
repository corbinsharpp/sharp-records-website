---
import Layout from "../components/Layout.astro";
import ArtistArticle from "../components/ArtistArticle.astro";
import { getSite } from "../lib/content";
import { organization, artistSchema } from "../lib/schema";
import { shareImage } from "../lib/images";

const site = await getSite();
const page = site.sections.artists;
const people = await Promise.all(site.artists.map(async (artist) => artistSchema(artist, await shareImage(artist.data.photo))));
---

<Layout title={`${page.data.title} | Sharp Records`} description={page.data.description} jsonLd={{ "@context": "https://schema.org", "@graph": [organization({ email: site.settings.data.email, city: site.settings.data.city, country: site.settings.data.country, countryCode: site.settings.data.countryCode, genres: site.genres, description: site.homepage.data.seoDescription }), ...people] }}>
  <header class="page-hero">
    <div class="wrap">
      <p class="eyebrow">{page.data.eyebrow}</p>
      <h1>{page.data.title}</h1>
      <p class="lede">{page.data.lede}</p>
    </div>
  </header>
  <section class="section">
    <div class="wrap">
      {site.artists.length > 0 ? site.artists.map((artist) => (
        <ArtistArticle artist={artist} releases={site.releases} variant="page" />
      )) : <p class="lede">No artists published.</p>}
    </div>
  </section>
</Layout>
